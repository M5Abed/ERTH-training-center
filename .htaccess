# =========================================================
# NMU ERTH Training Center — Hostinger Apache / LiteSpeed Config
# =========================================================

Options -Indexes
Options +FollowSymLinks

RewriteEngine On
RewriteBase /

# ── Force HTTPS (Recommended on Hostinger) ─────────────────
# Uncomment the following 2 lines if you want Apache to force HTTPS
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Allow Direct Access to API & Uploads ───────────────────
RewriteRule ^api/ - [L]
RewriteRule ^uploads/ - [L]

# ── Serve static assets from dist/ if present ───────────────
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.+)$ dist/$1 [L]

# ── Serve direct files & directories if they exist ─────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Root Directory → serve index.html ───────────────────────
RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
RewriteRule ^$ dist/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^$ index.html [L]

# ── Single Page Application (SPA) Fallback ─────────────────
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
RewriteRule ^ dist/index.html [L]

RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^ index.html [L]

# ── Block access to sensitive files & configurations ────────
<FilesMatch "^(\.env|\.git|\.docker|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|tsconfig\.json)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|bak|old|tmp|md|docx\.backup)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Block access to internal directories ───────────────────
RewriteRule ^(db_dump|scratch|dev|node_modules|frontend|\.git)/ - [F,L]
RewriteRule ^api/(migrations|dev)/ - [F,L]
RewriteRule ^api/(test.*|describe|migrate|run_migration|seed_.*)\.php$ - [F,L]

# ── Security Headers ──────────────────────────────────────
<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.groq.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self';"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set X-Permitted-Cross-Domain-Policies "none"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ── PHP Settings & Session Hardening ──────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
    php_value session.use_only_cookies 1
</IfModule>

# ── Browser Caching for Production Performance ────────────
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML must always revalidate for instant frontend updates
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    
    # Hashed JS and CSS
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Media and Images
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Prevent caching of index.html so users always get the latest build
<FilesMatch "^index\.html$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# ── Gzip Compression ──────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

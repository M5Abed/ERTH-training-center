# ── Database (Hostinger MySQL) ───────────────────────────
DB_HOST=localhost
DB_NAME=u846805811_training
DB_USER=u846805811_training
DB_PASS=Your_Hostinger_Database_Password_Here
DB_CHARSET=utf8mb4

# ── Allowed Domains & URLs ───────────────────────────────
ALLOWED_ORIGINS=https://training.erth.dev,http://localhost:5173,http://localhost

# ── Email Settings (Hostinger Business Email / SMTP) ─────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@erth.dev
SMTP_PASS=Your_Hostinger_Email_Password
SMTP_FROM_EMAIL=info@erth.dev
SMTP_FROM_NAME="ERTH Training Center"

# ── AI Acceleration Engine (Groq Cloud API) ──────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

AI_DAILY_USER_TOKEN_LIMIT=100000

# ── Database ─────────────────────────────────────────────────
# Keep DB_HOST=db when running via Docker Compose (internal network)
DB_HOST=db
DB_NAME=nmu_thinktank
DB_USER=erth_user
DB_PASS=change_me_in_production
DB_CHARSET=utf8mb4

# ── CORS ─────────────────────────────────────────────────────
# Add the VM's IP or hostname so browsers can reach the API.
# Same-origin requests (browser and server on same host) are
# automatically allowed regardless of this setting.
# Separate multiple origins with commas.
# Example: ALLOWED_ORIGINS=http://192.168.1.50,http://thinktank.cs.nmu.edu.eg
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@erth.dev
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@erth.dev
SMTP_FROM_NAME="NMU ThinkTank"

# ── AI Acceleration Engine (Groq Cloud API — 5-Key Rotation) ────────
GROQ_API_KEYS_ARRAY='["gsk_key1...", "gsk_key2...", "gsk_key3...", "gsk_key4...", "gsk_key5..."]'
GROQ_KEY_1="gsk_key1..."
GROQ_KEY_2="gsk_key2..."
GROQ_KEY_3="gsk_key3..."
GROQ_KEY_4="gsk_key4..."
GROQ_KEY_5="gsk_key5..."
GROQ_MODEL="openai/gpt-oss-120b"
AI_DAILY_USER_TOKEN_LIMIT=100000

